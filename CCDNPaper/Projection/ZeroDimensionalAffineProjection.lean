import CCDN.Algebra.ProjectionScalarExtension
import CCDNPaper.Algebra.ReconstructionFunctionField
import CCDNPaper.Determinant.HypersurfaceOriginStalk
import CCDNPaper.Hypersurface.ZeroDimensionalGeometricPoint
import CCDNPaper.Projection.AffineLinearCountTransfer

/-! The zero-dimensional boundary of the affine projection theorem.
The source is a rational point; the zero integer projection maps it finitely
and birationally to the origin in the affine line. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/-- Every projection of the ideal of a rational point is surjective: constants already hit
every residue class. -/
private theorem projectionCoordinateMap_surjective_of_eq_ker_eval {K σ : Type*} [Field K] {n : ℕ}
    (x : Fin n → K) (I : Ideal (MvPolynomial (Fin n) K)) (hI : I = RingHom.ker (eval x))
    (a : σ → MvPolynomial (Fin n) K) : Function.Surjective (projectionCoordinateMap I a) := by
  intro z
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
  refine ⟨C (eval x p), ?_⟩
  change Ideal.Quotient.mk I (aeval a (C (eval x p))) = Ideal.Quotient.mk I p
  rw [aeval_C, algebraMap_eq]
  apply Ideal.Quotient.eq.mpr
  rw [hI]
  change eval x (C (eval x p) - p) = 0
  simp

/-- Any family of linear forms generates the function field of a rational point. -/
private theorem adjoin_eq_top_of_eq_ker_eval {K σ : Type*} [Field K] {n : ℕ}
    (x : Fin n → K) (I : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]
    (hI : I = RingHom.ker (eval x)) (a : σ → MvPolynomial (Fin n) K) :
    IntermediateField.adjoin K
      (Set.range (fun i => algebraMap (MvPolynomial (Fin n) K ⧸ I)
        (FractionRing (MvPolynomial (Fin n) K ⧸ I)) ((Ideal.Quotient.mk I) (a i)))) = ⊤ := by
  refine reconstruction_generates_functionField I a 1 (fun i => C (x i)) ?_ (fun i => ?_)
  · rw [map_one]
    intro h
    exact Ideal.IsPrime.ne_top ‹I.IsPrime› (Ideal.eq_top_of_isUnit_mem I h isUnit_one)
  · rw [hI]
    change eval x (aeval a 1 * X i - aeval a (C (x i))) = 0
    simp

/-- The zero projection of a rational point to the affine line has kernel generated by the
coordinate. -/
private theorem ker_projectionCoordinateMap_zero_of_eq_ker_eval {K : Type*} [Field K] {n : ℕ}
    (x : Fin n → K) (I : Ideal (MvPolynomial (Fin n) K)) (hI : I = RingHom.ker (eval x)) :
    RingHom.ker (projectionCoordinateMap I (0 : Fin 1 → MvPolynomial (Fin n) K)) =
      Ideal.span {X 0} := by
  have hvars : RingHom.ker (projectionCoordinateMap I (0 : Fin 1 → MvPolynomial (Fin n) K)) =
      idealOfVars (Fin 1) K := by
    ext p
    rw [mem_projectionCoordinateMap_ker, hI, idealOfVars_eq_ker_constantCoeff]
    change eval x (aeval 0 p) = 0 ↔ constantCoeff p = 0
    rw [aeval_zero]
    simp only [algebraMap_eq, eval_C]
  rw [hvars, idealOfVars]
  congr 1
  ext p
  simp only [Set.mem_range, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    congr 1
    exact Subsingleton.elim _ _
  · rintro rfl
    exact ⟨0, rfl⟩

/-- The coordinate of the affine line is irreducible. -/
private theorem irreducible_X_fin_one (K : Type*) [Field K] :
    Irreducible (X (0 : Fin 1) : MvPolynomial (Fin 1) K) := by
  apply irreducible_of_totalDegree_eq_one (totalDegree_X _)
  intro c hc
  apply isUnit_of_dvd_one
  simpa using hc (Finsupp.single 0 1)

/-- A set of common zeros of the ideal of a rational point has at most one element. -/
private theorem card_le_one_of_eq_ker_eval {K : Type*} [Field K] {n : ℕ}
    (x : Fin n → K) (I : Ideal (MvPolynomial (Fin n) K)) (hI : I = RingHom.ker (eval x))
    (s : Finset (Fin n → K)) (hzero : ∀ y ∈ s, y ∈ idealZeroLocus I) : s.card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro y hy w hw
  funext i
  have hmem : X i - C (x i) ∈ I := by
    rw [hI]
    change eval x (X i - C (x i)) = 0
    simp
  have hy' := hzero y hy _ hmem
  have hw' := hzero w hw _ hmem
  simp only [map_sub, eval_X, eval_C, sub_eq_zero] at hy' hw'
  exact hy'.trans hw'.symm

/-- The zero-dimensional case of the affine projection theorem: a geometrically integral
zero-dimensional prime is a rational point of degree one, and the zero integer projection maps
it finitely and birationally onto the origin of the affine line. -/
theorem exists_geometric_affine_projection_zero_dimension
    {L : Type*} [Field L] [Algebra ℚ L] [IsAlgClosed L] [IsGalois ℚ L]
    (n : ℕ) (I : Ideal (MvPolynomial (Fin n) ℚ)) [I.IsPrime]
    [(I.map (map (algebraMap ℚ L))).IsPrime]
    (d : ℕ) (hdim : (filteredHilbertPolynomial I).natDegree = 0)
    (hdegree : (filteredHilbertPolynomial I).leadingCoeff = d) :
    ∃ (b : Fin 1 → Fin n → ℤ) (f : MvPolynomial (Fin 1) ℚ),
      (∀ i j, |b i j| ≤ integerBirationalProjectionHeight n d) ∧
      IsBirationalProjection I (fun i => integerLinearForm (b i)) f ∧
      Irreducible (map (algebraMap ℚ L) f) ∧ f.totalDegree = d ∧
      ∀ B : ℝ, 1 ≤ B → count (idealZeroLocus I) B ≤
        d * count (zeroLocus f)
          ((affineProjectionHeightConstant n : ℝ) * (d : ℝ) ^ (2 * n) * B) := by
  classical
  obtain ⟨x, hIker, hP⟩ := zero_dimensional_geometrically_integral_point (L := L) I hdim
  have hd : d = 1 := by
    have hh : (d : ℚ) = 1 := by simpa only [hP, Polynomial.leadingCoeff_one] using hdegree.symm
    exact_mod_cast hh
  subst d
  let b : Fin 1 → Fin n → ℤ := fun _ _ => 0
  have ha : (fun i => integerLinearForm (b i)) = 0 := by
    funext i
    simp [b, linearForm]
  refine ⟨b, X 0, fun i j => ?_, ⟨⟨adjoin_eq_top_of_eq_ker_eval x I hIker _,
    irreducible_X_fin_one ℚ, ?_⟩, RingHom.isIntegral_of_surjective _
      (projectionCoordinateMap_surjective_of_eq_ker_eval x I hIker _)⟩, ?_, totalDegree_X _,
    fun B hB => ?_⟩
  · simp only [b, abs_zero]
    exact Nat.cast_nonneg _
  · rw [ha]
    exact ker_projectionCoordinateMap_zero_of_eq_ker_eval x I hIker
  · rw [map_X]
    exact irreducible_X_fin_one L
  · have hrel : aeval (R := ℚ) (fun i => integerLinearForm (b i)) (X 0) ∈ I := by simp [ha]
    have hh := affine_integer_linear_count_transfer I b (X 0) hrel 1
      (fun _ s hzero _ => card_le_one_of_eq_ker_eval x I hIker s hzero)
      0 B le_rfl (fun _ _ => by simp [b])
    simp only [one_mul, mul_zero, zero_mul] at hh
    simp only [one_mul]
    exact hh.trans (count_mono (Set.Subset.refl _) (by positivity))

end
end CCDN
