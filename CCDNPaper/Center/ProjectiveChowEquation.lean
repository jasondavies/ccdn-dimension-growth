module

public import CCDN.Hilbert.FilteredHilbertPolynomial
public import CCDNPaper.Center.ProjectiveChowIncidence
import CCDNPaper.Center.ChowIncidenceBaseChange
import CCDNPaper.Center.PrincipalWeightedHomogeneous
import CCDNPaper.Center.ProjectiveClosureRecovery
import CCDNPaper.Center.ProjectiveIncidenceClosed

/-!
The constructed irreducible multihomogeneous incidence equation has the
projective intersection criterion. The criterion also holds over an
algebraically closed coefficient extension and for a homogeneous prime ideal
recovered from its nonempty standard chart. Exact block degrees are separate.

Constructed incidence equations with separate homogeneity and
geometric irreducibility.
-/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

private theorem exists_multihomogeneous_chow_incidence_generator
    {K : Type*} [Field K] {n m : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 1)) K)) [I.IsPrime]
    (hm : (filteredHilbertPolynomial I).natDegree = m) :
    ∃ (F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K) (δ : Fin (m + 1) → ℕ),
      Irreducible F ∧ chowIncidenceIdeal (m + 1) I = Ideal.span {F} ∧
      ∀ i, F.IsWeightedHomogeneous (chowRowWeight i) (δ i) := by
  obtain ⟨F,hF,hgen⟩ := exists_chow_incidence_generator_of_dimension I hm
  obtain ⟨δ,hδ⟩ := chow_incidence_generator_multihomogeneous I F hF.ne_zero hgen
  exact ⟨F,δ,hF,hgen,hδ⟩

/-- Let `I` be a prime ideal in `n + 1` affine variables over `K` whose filtered Hilbert polynomial
has degree `m`, and which stays prime over an extension `L`. The Chow incidence ideal of `m + 1`
hyperplanes on `I` is generated by an irreducible polynomial `F` that is weighted homogeneous in
each row of hyperplane coefficients and remains irreducible over `L`. -/
theorem exists_geometric_chow_incidence_generator
    {K L : Type*} [Field K] [Field L] [Algebra K L] {n m : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 1)) K)) [I.IsPrime]
    [(I.map (map (algebraMap K L))).IsPrime]
    (hm : (filteredHilbertPolynomial I).natDegree = m) :
    ∃ (F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K) (δ : Fin (m + 1) → ℕ),
      Irreducible F ∧ chowIncidenceIdeal (m + 1) I = Ideal.span {F} ∧
      (∀ i, F.IsWeightedHomogeneous (chowRowWeight i) (δ i)) ∧
      Irreducible (map (algebraMap K L) F) := by
  obtain ⟨F,δ,hF,hgen,hδ⟩ := exists_multihomogeneous_chow_incidence_generator I hm
  exact ⟨F,δ,hF,hgen,hδ,
    chow_incidence_equation_irreducible_map (m + 1) I F hF.ne_zero hgen⟩

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

/-- Over an algebraically closed field, let `F` generate the Chow incidence ideal of `r` hyperplanes
on the affine variety of a prime ideal `I`. Then `F` vanishes at a coefficient tuple `U` exactly
when the `r` hyperplanes with coefficients `U` have a common point on the projective closure of the
variety. -/
theorem chow_incidence_generator_eval_eq_zero_iff
    {K : Type*} [Field K] [IsAlgClosed K] {n : ℕ}
    (r : ℕ) (I : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]
    (F : MvPolynomial (Fin r × Fin (n + 1)) K)
    (hgen : chowIncidenceIdeal r I = Ideal.span {F})
    (U : Fin r × Fin (n + 1) → K) :
    eval U F = 0 ↔ U ∈ projectiveChowIncidenceLocus r (projectiveClosureIdeal I) := by
  rw [← chowIncidenceIdeal_zeroLocus_eq_projective_incidence, hgen, zeroLocus_span]
  simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff, forall_eq, aeval_eq_eval]

private theorem chow_incidence_generator_eval_map_eq_zero_iff
    {K L : Type*} [Field K] [Field L] [Algebra K L] [IsAlgClosed L] {n : ℕ}
    (r : ℕ) (I : Ideal (MvPolynomial (Fin n) K))
    [(I.map (map (algebraMap K L))).IsPrime]
    (F : MvPolynomial (Fin r × Fin (n + 1)) K)
    (hgen : chowIncidenceIdeal r I = Ideal.span {F})
    (U : Fin r × Fin (n + 1) → L) :
    eval U (map (algebraMap K L) F) = 0 ↔
      U ∈ projectiveChowIncidenceLocus r
        ((projectiveClosureIdeal I).map (map (algebraMap K L))) := by
  have hgenL : chowIncidenceIdeal r (I.map (map (algebraMap K L))) =
      Ideal.span {map (algebraMap K L) F} := by
    rw [← chowIncidenceIdeal_scalar_extension, hgen, Ideal.map_span, Set.image_singleton]
  rw [projectiveClosureIdeal_scalar_extension]
  exact chow_incidence_generator_eval_eq_zero_iff r _ _ hgenL U

/-- The Chow equation is constructed from the affine ideal; its zeros
are exactly hyperplane tuples meeting the full projective compactification. -/
private theorem exists_projective_chow_incidence_equation
    {K : Type*} [Field K] [IsAlgClosed K] {n m : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 1)) K)) [I.IsPrime]
    (hm : (filteredHilbertPolynomial I).natDegree = m) :
    ∃ (F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K) (δ : Fin (m + 1) → ℕ),
      chowIncidenceIdeal (m + 1) I = Ideal.span {F} ∧
      IsProjectiveChowEquation (projectiveClosureIdeal I) F δ := by
  obtain ⟨F, δ, hF, hgen, hδ⟩ := exists_multihomogeneous_chow_incidence_generator I hm
  exact ⟨F, δ, hgen, hF, hδ,
    chow_incidence_generator_eval_eq_zero_iff (m + 1) I F hgen⟩

/-- A geometrically integral source gives a base-field equation which stays
irreducible and has the exact incidence criterion over the algebraic closure. -/
theorem exists_geometric_projective_chow_incidence_equation
    {K L : Type*} [Field K] [Field L] [Algebra K L] [IsAlgClosed L] {n m : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 1)) K)) [I.IsPrime]
    [(I.map (map (algebraMap K L))).IsPrime]
    (hm : (filteredHilbertPolynomial I).natDegree = m) :
    ∃ (F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K) (δ : Fin (m + 1) → ℕ),
      chowIncidenceIdeal (m + 1) I = Ideal.span {F} ∧ Irreducible F ∧
      IsProjectiveChowEquation ((projectiveClosureIdeal I).map (map (algebraMap K L)))
        (map (algebraMap K L) F) δ := by
  obtain ⟨F, δ, hF, hgen, hδ, hFL⟩ := exists_geometric_chow_incidence_generator (L := L) I hm
  exact ⟨F, δ, hgen, hF, hFL,
    fun i => (isWeightedHomogeneous_map_iff (algebraMap K L).injective _ _ _).mpr (hδ i),
    chow_incidence_generator_eval_map_eq_zero_iff (m + 1) I F hgen⟩

/-- The criterion for a homogeneous prime source, with a specified
nonempty standard chart. Its dimension and degree are those of the cone Hilbert
polynomial; the chart and Chow generator are constructed internally. -/
theorem exists_homogeneous_prime_projective_chow_equation
    {K : Type*} [Field K] [IsAlgClosed K] {n m d : ℕ}
    (J : Ideal (MvPolynomial (Fin (n + 2)) K)) [J.IsPrime]
    (hJ : IsHomogeneousIdeal J)
    (hX : X 0 ∉ J)
    (hdimdeg : HasProjectiveDimensionDegree J m d) :
    ∃ (F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K) (δ : Fin (m + 1) → ℕ),
      IsProjectiveChowEquation J F δ := by
  obtain ⟨hm, _⟩ := projectiveChartIdeal_hilbertPolynomial_parameters J hJ hX m d hdimdeg
  obtain ⟨F, δ, _, hF⟩ :=
    exists_projective_chow_incidence_equation (projectiveChartIdeal J) hm
  rw [projectiveClosureIdeal_chartIdeal_eq J hJ hX] at hF
  exact ⟨F, δ, hF⟩

end
end CCDN
