module

public import CCDNPaper.Center.GenericLinearPowerBasis
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import CCDN.Height.BoundedPrimitiveElement
import CCDN.Projection.PrimitiveCoordinateField
import Mathlib.RingTheory.AlgebraicIndependent.Basic

/-!
The generic primitive element over the intermediate field
inside the polynomial fraction field generated by its parameter variables.

Generic primitive linear combinations of a separating coordinate tuple.
The primitive specialization is constructed by the bounded primitive-element
theorem.
-/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial
attribute [local instance] MvPolynomial.algebraMvPolynomial

private theorem generic_linear_primitive
    {K A R F : Type*} [Field K] [CharZero K] [Field A] [Algebra K A]
    [Module.Finite K A] [Field R] [Field F] {n : ℕ}
    [Algebra (MvPolynomial (Fin n) K) R]
    [IsFractionRing (MvPolynomial (Fin n) K) R]
    [Algebra (MvPolynomial (Fin n) A) F]
    [IsFractionRing (MvPolynomial (Fin n) A) F]
    [Algebra (MvPolynomial (Fin n) K) F] [Algebra R F]
    [IsScalarTower (MvPolynomial (Fin n) K) R F]
    [IsScalarTower (MvPolynomial (Fin n) K) (MvPolynomial (Fin n) A) F]
    (x : Fin n → A)
    (hsep : Function.Injective
      (fun φ : A →ₐ[K] AlgebraicClosure K => fun j => φ (x j))) :
    Module.finrank R F = Module.finrank K A ∧
    (minpoly R (algebraMap (MvPolynomial (Fin n) A) F
      (linearForm x))).natDegree = Module.finrank K A ∧
    IntermediateField.adjoin R
      {algebraMap (MvPolynomial (Fin n) A) F (linearForm x)} = ⊤ := by
  classical
  obtain ⟨k,_,hk⟩ := exists_bounded_primitive_element x hsep
  let z := ∑j : Fin n, x j * (k : A) ^ j.val
  let b := PowerBasis.ofAdjoinSimpleEqTop (Algebra.IsIntegral.isIntegral (R := K) z) hk
  have hc : ∑i : Fin n, x i * algebraMap K A ((k : K) ^ i.val) = b.gen := by
    simp only [map_pow,map_natCast,PowerBasis.ofAdjoinSimpleEqTop_gen,b,z]
  let B := genericLinearPowerBasis (R := R) (F := F) b x
    (fun i => (k : K) ^ i.val) hc
  have hgen : B.gen = algebraMap (MvPolynomial (Fin n) A) F (linearForm x) := rfl
  have hdim : B.dim = Module.finrank K A := by
    change b.dim = _
    exact b.finrank.symm
  refine ⟨B.finrank.trans hdim,?_,?_⟩
  · rw [← hgen]
    exact B.natDegree_minpoly.trans hdim
  · have hle : Algebra.adjoin R {B.gen} ≤
        (IntermediateField.adjoin R {B.gen}).toSubalgebra := by
      apply Algebra.adjoin_le
      exact IntermediateField.subset_adjoin R _
    rw [B.adjoin_gen_eq_top] at hle
    rw [← hgen]
    apply top_unique
    intro a _
    exact hle (show a ∈ (⊤ : Subalgebra R F) from trivial)

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial
attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The subfield of `F` generated over `K` by the images of the variables `X i` of
`MvPolynomial σ A`. When `F` is a fraction field of `MvPolynomial σ A`, it is the rational function
field over `K` in these variables. -/
def polynomialParameterField {K A F σ : Type*}
    [Field K] [Field A] [Field F] [Algebra K A] [Algebra K F]
    [Algebra (MvPolynomial σ A) F] : IntermediateField K F :=
  IntermediateField.adjoin K (Set.range (fun i : σ =>
    algebraMap (MvPolynomial σ A) F (X i)))

/-- The parameter field is a fraction field of the polynomial ring over `K`, compatibly with
`F`. A statement that holds for every such structure holds for the parameter field. -/
theorem polynomialParameterField_rec {K A F σ : Type*} [Field K] [Field A] [Algebra K A]
    [Field F] [Algebra K F]
    [Algebra (MvPolynomial σ A) F] [IsFractionRing (MvPolynomial σ A) F]
    [IsScalarTower K (MvPolynomial σ A) F] {P : Prop}
    (h : ∀ [Algebra (MvPolynomial σ K)
        (polynomialParameterField (K := K) (A := A) (F := F) (σ := σ))]
      [IsFractionRing (MvPolynomial σ K)
        (polynomialParameterField (K := K) (A := A) (F := F) (σ := σ))]
      [Algebra (MvPolynomial σ K) F]
      [IsScalarTower (MvPolynomial σ K)
        (polynomialParameterField (K := K) (A := A) (F := F) (σ := σ)) F]
      [IsScalarTower (MvPolynomial σ K) (MvPolynomial σ A) F], P) : P := by
  classical
  let P := MvPolynomial σ K
  let Q := MvPolynomial σ A
  let η : Q →ₐ[K] F := IsScalarTower.toAlgHom K Q F
  let v : σ → F := fun i => η (X i)
  let R := polynomialParameterField (K := K) (A := A) (F := F) (σ := σ)
  let u : σ → R := fun i => ⟨v i,IntermediateField.subset_adjoin K _ ⟨i,rfl⟩⟩
  have hQ : AlgebraicIndependent K (X : σ → Q) := by
    have he : (aeval (X : σ → Q) : P →ₐ[K] Q).toRingHom = map (algebraMap K A) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change (aeval (X : σ → Q) : P →ₐ[K] Q) (C c) = _
        rw [aeval_C]
        change algebraMap K (MvPolynomial σ A) c =
          MvPolynomial.map (algebraMap K A) (C c)
        simp only [MvPolynomial.map_C,MvPolynomial.algebraMap_apply]
      · intro i
        change (aeval (X : σ → Q) : P →ₐ[K] Q) (X i) = _
        rw [aeval_X]
        change (X i : MvPolynomial σ A) =
          MvPolynomial.map (algebraMap K A) (X i)
        rw [MvPolynomial.map_X]
    change Function.Injective (aeval (X : σ → Q) : P →ₐ[K] Q)
    change Function.Injective (aeval (X : σ → Q) : P →ₐ[K] Q).toRingHom
    rw [he]
    exact map_injective _ (algebraMap K A).injective
  have hF : AlgebraicIndependent K v := hQ.map' (IsFractionRing.injective Q F)
  have hR : AlgebraicIndependent K u := AlgebraicIndependent.of_comp R.val hF
  let ρ : P →ₐ[K] R := aeval u
  let ψ : P →ₐ[K] F := aeval v
  have heq : R.val.comp ρ = ψ := by ext i; simp [ρ,ψ,u]
  let : Algebra P R := ρ.toRingHom.toAlgebra
  let : Algebra P F := ψ.toRingHom.toAlgebra
  let : IsScalarTower P R F := IsScalarTower.of_algebraMap_eq' (congrArg AlgHom.toRingHom heq).symm
  let : IsScalarTower P Q F := IsScalarTower.of_algebraMap_eq' (by
    change ψ.toRingHom = (algebraMap Q F).comp (map (algebraMap K A))
    apply MvPolynomial.ringHom_ext
    · intro c
      change (aeval v) (C c) = algebraMap Q F
        (MvPolynomial.map (algebraMap K A) (C c))
      rw [aeval_C,MvPolynomial.map_C]
      exact IsScalarTower.algebraMap_apply K Q F c
    · intro i
      change (aeval v) (X i) = algebraMap Q F
        (MvPolynomial.map (algebraMap K A) (X i))
      rw [aeval_X,MvPolynomial.map_X]
      rfl)
  have hgen : IntermediateField.adjoin K (Set.range u) = ⊤ := by
    apply IntermediateField.lift_injective R
    rw [IntermediateField.lift_adjoin,IntermediateField.lift_top,← Set.range_comp]
    rfl
  let : IsFractionRing P R := isFractionRing_of_generating_tuple ρ hR
    (fun i => X i) (by
      convert hgen using 2
      congr 1
      funext i
      change (aeval u) (X i) = u i
      rw [aeval_X])
  exact h

/-- Let `A` be a finite extension of a field `K` of characteristic zero, `F` a fraction field of
`MvPolynomial (Fin n) A`, and `R ⊆ F` the rational function field over `K` in the variables. If the
tuple `x` separates the `K`-embeddings of `A` into an algebraic closure, then `[F : R] = [A : K]`
and the generic linear form `∑ j, x j * X j` is a primitive element of `F` over `R` whose minimal
polynomial has degree `[A : K]`. -/
theorem generic_linear_parameter_field_degree
    {K A F : Type*} [Field K] [CharZero K] [Field A] [Algebra K A]
    [Module.Finite K A] [Field F] [Algebra K F] {n : ℕ}
    [Algebra (MvPolynomial (Fin n) A) F]
    [IsFractionRing (MvPolynomial (Fin n) A) F]
    [IsScalarTower K (MvPolynomial (Fin n) A) F]
    (x : Fin n → A)
    (hsep : Function.Injective
      (fun φ : A →ₐ[K] AlgebraicClosure K => fun j => φ (x j))) :
    let R := polynomialParameterField (K := K) (A := A) (F := F) (σ := Fin n)
    Module.finrank R F = Module.finrank K A ∧
    (minpoly R (algebraMap (MvPolynomial (Fin n) A) F
      (linearForm x))).natDegree = Module.finrank K A ∧
    IntermediateField.adjoin R
      {algebraMap (MvPolynomial (Fin n) A) F (linearForm x)} = ⊤ := by
  refine polynomialParameterField_rec (K := K) (A := A) (F := F) (σ := Fin n) ?_
  intro _ _ _ _ _
  exact generic_linear_primitive
    (R := polynomialParameterField (K := K) (A := A) (F := F) (σ := Fin n)) (F := F) x hsep

end
end CCDN
