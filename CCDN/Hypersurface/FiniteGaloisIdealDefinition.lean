module

public import CCDN.Algebra.IdealScalarDescent
public import Mathlib.FieldTheory.Galois.GaloisClosure

/-! Every affine ideal over an algebraic Galois extension is defined over
a constructed finite Galois intermediate field. The field is generated by
the coefficients of finite ideal generators. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

theorem exists_finite_galois_ideal_definition
    (k K : Type*) [Field k] [Field K] [Algebra k K] [IsGalois k K]
    {n : ℕ} (I : Ideal (MvPolynomial (Fin n) K)) :
    ∃ L : FiniteGaloisIntermediateField k K,
      (I.comap (map (algebraMap L K))).map (map (algebraMap L K)) = I := by
  classical
  obtain ⟨S, hS⟩ := IsNoetherian.noetherian I
  let T : Finset K := S.biUnion (fun f => f.coeffs)
  let L := FiniteGaloisIntermediateField.adjoin k (T : Set K)
  have hpre (f : MvPolynomial (Fin n) K) (hf : f ∈ S) :
      ∃ g : MvPolynomial (Fin n) L, map (algebraMap L K) g = f := by
    apply mem_range_map_iff_coeffs_subset.mpr
    intro c hc
    have hcT : c ∈ (T : Set K) := Finset.mem_biUnion.mpr ⟨f, hf, hc⟩
    have hcL := FiniteGaloisIntermediateField.subset_adjoin k (T : Set K) hcT
    exact ⟨⟨c, hcL⟩, rfl⟩
  refine ⟨L, le_antisymm (Ideal.map_comap_le) ?_⟩
  rw [← hS]
  apply Ideal.span_le.mpr
  intro f hf
  obtain ⟨g, hg⟩ := hpre f hf
  rw [← hg]
  apply Ideal.mem_map_of_mem
  change map (algebraMap L K) g ∈ Ideal.span (S : Set (MvPolynomial (Fin n) K))
  rw [hg]
  exact Ideal.subset_span hf

end
end CCDN
