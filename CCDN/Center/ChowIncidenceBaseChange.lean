/-!
Generators and base change of the Chow incidence ideal. A nonzero polynomial-map kernel
containing all but one independent coordinate is generated by an irreducible equation; more
hyperplanes than the affine Hilbert dimension satisfy a nonzero incidence equation, constructed
from the elimination kernel by a transcendence-degree count; and the incidence ideal of `m + 1`
hyperplanes on an `m`-dimensional affine variety is generated by an irreducible equation.

The incidence ideal commutes exactly with field base change: lift the incidence substitution
before taking the coordinate quotient, then test membership coefficientwise and descend by
linear coefficient functionals.
-/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/-- The incidence substitution before quotienting by the source ideal. -/
private def chowIncidencePolynomialMap {K : Type*} [Field K] {n : ℕ} (r : ℕ) :
    MvPolynomial (Fin r × Fin (n + 1)) K →ₐ[K]
      MvPolynomial (Fin r × Fin n) (MvPolynomial (Fin n) K) :=
  aeval (fun q => Fin.cases
    (-(∑ j, X (q.1,j) * C (X j))) (fun j => X (q.1,j)) q.2)

private lemma chowIncidencePolynomialMap_quotient {K : Type*} [Field K] {n : ℕ}
    (r : ℕ) (I : Ideal (MvPolynomial (Fin n) K))
    (f : MvPolynomial (Fin r × Fin (n + 1)) K) :
    map (Ideal.Quotient.mk I) (chowIncidencePolynomialMap r f) = chowIncidenceMap r I f := by
  have he : (map (Ideal.Quotient.mk I)).comp (chowIncidencePolynomialMap r).toRingHom =
      (chowIncidenceMap r I).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [chowIncidencePolynomialMap, chowIncidenceMap]
      rfl
    · rintro ⟨i,j⟩
      refine Fin.cases ?_ (fun k => ?_) j <;>
        simp [chowIncidencePolynomialMap, chowIncidenceMap]
  exact RingHom.congr_fun he f

private lemma mem_chowIncidenceIdeal_iff_coeff {K : Type*} [Field K] {n r : ℕ}
    (I : Ideal (MvPolynomial (Fin n) K))
    (f : MvPolynomial (Fin r × Fin (n + 1)) K) :
    f ∈ chowIncidenceIdeal r I ↔
      ∀ e, (chowIncidencePolynomialMap r f).coeff e ∈ I := by
  change chowIncidenceMap r I f = 0 ↔ _
  rw [← chowIncidencePolynomialMap_quotient, MvPolynomial.ext_iff]
  simp only [coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
    Ideal.Quotient.eq_zero_iff_mem]

private lemma chowIncidencePolynomialMap_map {K L : Type*}
    [Field K] [Field L] [Algebra K L] {n : ℕ} (r : ℕ)
    (f : MvPolynomial (Fin r × Fin (n + 1)) K) :
    map (map (algebraMap K L)) (chowIncidencePolynomialMap r f) =
      chowIncidencePolynomialMap r (map (algebraMap K L) f) := by
  have he : (map (map (algebraMap K L))).comp
      (chowIncidencePolynomialMap (K := K) (n := n) r).toRingHom =
      (chowIncidencePolynomialMap (K := L) (n := n) r).toRingHom.comp
        (map (algebraMap K L)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [chowIncidencePolynomialMap]
    · rintro ⟨i,j⟩
      refine Fin.cases ?_ (fun k => ?_) j <;> simp [chowIncidencePolynomialMap]
  exact RingHom.congr_fun he f

/-- Linear descent commutes with the nested incidence substitution. -/
private lemma chowIncidencePolynomialMap_coefficientLinear {K L : Type*}
    [Field K] [Field L] [Algebra K L] {n : ℕ}
    (r : ℕ) (φ : L →ₗ[K] K)
    (f : MvPolynomial (Fin r × Fin (n + 1)) L) :
    polynomialCoefficientLinear (polynomialCoefficientLinear φ)
        (chowIncidencePolynomialMap r f) =
      chowIncidencePolynomialMap r (polynomialCoefficientLinear φ f) := by
  have hmul (g : MvPolynomial (Fin r × Fin n) (MvPolynomial (Fin n) L))
      (h : MvPolynomial (Fin r × Fin n) (MvPolynomial (Fin n) K)) :
      polynomialCoefficientLinear (polynomialCoefficientLinear φ)
          (g * map (map (algebraMap K L)) h) =
        polynomialCoefficientLinear (polynomialCoefficientLinear φ) g * h :=
    polynomialCoefficientLinear_mul_compatible _ _
      (fun a b => polynomialCoefficientLinear_mul_map φ a b) g h
  induction f using MvPolynomial.induction_on with
  | C c => simp [chowIncidencePolynomialMap, polynomialCoefficientLinear_C]
  | add f g hf hg => simp only [map_add, hf, hg]
  | mul_X f q hf =>
      have hX : (X q : MvPolynomial (Fin r × Fin (n + 1)) L) =
          map (algebraMap K L) (X q) := by simp
      rw [map_mul, hX, ← chowIncidencePolynomialMap_map, hmul, hf,
        polynomialCoefficientLinear_mul_map, map_mul]

/-- Field extension commutes with the constructed incidence ideal, for
arbitrary source ideals. -/
theorem chowIncidenceIdeal_scalar_extension {K L : Type*}
    [Field K] [Field L] [Algebra K L] {n : ℕ}
    (r : ℕ) (I : Ideal (MvPolynomial (Fin n) K)) :
    (chowIncidenceIdeal r I).map (map (algebraMap K L)) =
      chowIncidenceIdeal r (I.map (map (algebraMap K L))) := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro f hf
    rw [Ideal.mem_comap, mem_chowIncidenceIdeal_iff_coeff]
    intro e
    rw [← chowIncidencePolynomialMap_map, coeff_map]
    exact Ideal.mem_map_of_mem _ ((mem_chowIncidenceIdeal_iff_coeff I f).mp hf e)
  · intro f hf
    apply (mem_scalar_extension_iff_polynomialCoefficientLinear _ f).mpr
    intro φ
    rw [mem_chowIncidenceIdeal_iff_coeff]
    intro e
    rw [← chowIncidencePolynomialMap_coefficientLinear, polynomialCoefficientLinear_coeff]
    exact polynomialCoefficientLinear_mem_scalar_extension I _
      ((mem_chowIncidenceIdeal_iff_coeff _ f).mp hf e) φ

/-- Geometric primeness of the source implies geometric primeness of its
incidence ideal. The scalar extension is identified before using
primality of the target polynomial ring. -/
private theorem chowIncidenceIdeal_geometrically_prime {K L : Type*}
    [Field K] [Field L] [Algebra K L] {n : ℕ}
    (r : ℕ) (I : Ideal (MvPolynomial (Fin n) K))
    [(I.map (map (algebraMap K L))).IsPrime] :
    ((chowIncidenceIdeal r I).map (map (algebraMap K L))).IsPrime := by
  rw [chowIncidenceIdeal_scalar_extension]
  infer_instance

/-- Consequently a nonzero principal incidence equation stays
irreducible after every field extension over which the source remains prime. -/
theorem chow_incidence_equation_irreducible_map {K L : Type*}
    [Field K] [Field L] [Algebra K L] {n : ℕ}
    (r : ℕ) (I : Ideal (MvPolynomial (Fin n) K))
    [(I.map (map (algebraMap K L))).IsPrime]
    (f : MvPolynomial (Fin r × Fin (n + 1)) K) (hf : f ≠ 0)
    (hprincipal : chowIncidenceIdeal r I = Ideal.span {f}) :
    Irreducible (map (algebraMap K L) f) := by
  have hp := chowIncidenceIdeal_geometrically_prime (L := L) r I
  rw [hprincipal, Ideal.map_span, Set.image_singleton] at hp
  have hne : map (algebraMap K L) f ≠ 0 :=
    (map_ne_zero_iff _ (map_injective _ (algebraMap K L).injective)).mpr hf
  exact ((Ideal.span_singleton_prime hne).mp hp).irreducible

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

private theorem exists_irreducible_kernel_equation_of_independent_coordinates
    {K A σ τ : Type*} [Field K] [CommRing A] [IsDomain A] [Algebra K A]
    [Fintype σ] [Fintype τ]
    (ψ : MvPolynomial σ K →ₐ[K] A)
    (hne : RingHom.ker ψ ≠ ⊥) (hn : 2 ≤ Fintype.card σ)
    (b : τ → σ) (hcard : Fintype.card τ + 1 = Fintype.card σ)
    (hi : AlgebraicIndependent K (fun i => ψ (X (b i)))) :
    ∃ f : MvPolynomial σ K, Irreducible f ∧ RingHom.ker ψ = Ideal.span {f} := by
  classical
  have hp : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime _
  obtain ⟨f,hf,hprime⟩ := hp.exists_mem_prime_of_ne_bot hne
  let k := Fintype.card σ - 2
  let e : Fin (k + 2) ≃ σ := Fintype.equivOfCardEq (by simp only [Fintype.card_fin]; omega)
  let j : Fin (k + 1) ≃ τ := Fintype.equivOfCardEq (by simp only [Fintype.card_fin]; omega)
  let E := renameEquiv K e
  let f' := E.symm f
  let ψ' := ψ.comp E.toAlgHom
  have hf' : Irreducible f' := (MulEquiv.irreducible_iff (f := E.symm)).mpr hprime.irreducible
  have hz : ψ' f' = 0 := by
    change ψ f = 0 at hf
    simpa [ψ',f'] using hf
  let b' : Fin (k + 1) → MvPolynomial (Fin (k + 2)) K := fun i => X (e.symm (b (j i)))
  have hb' (i) : (b' i).totalDegree ≤ 1 := by simp [b']
  have hi' : AlgebraicIndependent K (fun i => ψ' (b' i)) := by
    convert hi.comp j j.injective using 1
    funext i
    simp [ψ',b',E]
  refine ⟨f,hprime.irreducible,?_⟩
  ext g
  change ψ g = 0 ↔ g ∈ Ideal.span {f}
  rw [Ideal.mem_span_singleton]
  have hh := hypersurface_map_eq_zero_iff_dvd f' hf' ψ' hz b' hb' hi' (E.symm g)
  have hm : ψ' (E.symm g) = ψ g := by simp [ψ']
  rw [hm] at hh
  exact hh.trans (map_dvd_iff E.symm)

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

/-- The incidence elimination ideal is nonzero as soon as the number of
hyperplanes exceeds the dimension of the affine coordinate domain. -/
private theorem chowIncidenceIdeal_ne_bot {K : Type*} [Field K] {n r : ℕ}
    (I : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]
    (hr : (filteredHilbertPolynomial I).natDegree < r) :
    chowIncidenceIdeal r I ≠ ⊥ := by
  classical
  intro hbot
  have hinj : Function.Injective (chowIncidenceMap r I) :=
    (RingHom.injective_iff_ker_eq_bot (chowIncidenceMap r I)).mpr hbot
  have hAI : AlgebraicIndependent K (fun q : Fin r × Fin (n + 1) =>
      chowIncidenceMap r I (X q)) :=
    (algebraicIndependent_X (Fin r × Fin (n + 1)) K).map' hinj
  obtain ⟨U,hU,hTB⟩ := exists_hilbert_coordinate_transcendence_basis I
  let A := MvPolynomial (Fin n) K ⧸ I
  have hP := IsTranscendenceBasis.mvPolynomial (Fin r × Fin n) A
  have htarget := hTB.sumElim_comp hP
  have hle := hAI.lift_cardinalMk_le_trdeg
  have heq := htarget.lift_cardinalMk_eq_trdeg
  have hcard : Fintype.card (Fin r × Fin (n + 1)) ≤
      Fintype.card ((Fin r × Fin n) ⊕ U) := by
    simpa only [Cardinal.mk_fintype,Cardinal.lift_natCast,Nat.cast_le] using hle.trans_eq heq.symm
  simp only [Fintype.card_prod,Fintype.card_fin,Fintype.card_sum] at hcard
  rw [Nat.card_eq_fintype_card] at hU
  nlinarith

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

theorem exists_chow_incidence_generator_of_dimension {K : Type*} [Field K] {m n : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 1)) K)) [I.IsPrime]
    (hm : (filteredHilbertPolynomial I).natDegree = m) :
    ∃ F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K,
      Irreducible F ∧ chowIncidenceIdeal (m + 1) I = Ideal.span {F} := by
  have hne : chowIncidenceIdeal (m + 1) I ≠ ⊥ :=
    chowIncidenceIdeal_ne_bot (r := m + 1) I (by rw [hm]; exact Nat.lt_succ_self m)
  have hn : 2 ≤ Fintype.card (Fin (m + 1) × Fin (n + 2)) := by
    simp only [Fintype.card_prod,Fintype.card_fin]
    calc
      2 ≤ n + 2 := by omega
      _ ≤ (m + 1) * (n + 2) := Nat.le_mul_of_pos_left _ (Nat.succ_pos m)
  have hc : Fintype.card ((Fin (m + 1) × Fin (n + 1)) ⊕ Fin m) + 1 =
      Fintype.card (Fin (m + 1) × Fin (n + 2)) := by
    simp only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    ring
  have hi := chowIncidence_independent_coordinates (m := m) (n := n + 1) I hm
  let ψ : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K →ₐ[K]
      MvPolynomial (Fin (m + 1) × Fin (n + 1)) (MvPolynomial (Fin (n + 1)) K ⧸ I) :=
    chowIncidenceMap (m + 1) I
  have hψ : RingHom.ker ψ ≠ ⊥ := hne
  exact exists_irreducible_kernel_equation_of_independent_coordinates
    (K := K) (A := MvPolynomial (Fin (m + 1) × Fin (n + 1))
      (MvPolynomial (Fin (n + 1)) K ⧸ I))
    (σ := Fin (m + 1) × Fin (n + 2))
    (τ := (Fin (m + 1) × Fin (n + 1)) ⊕ Fin m)
    ψ hψ hn (chowIndependentVariables m (n + 1)) hc hi

end
end CCDN
