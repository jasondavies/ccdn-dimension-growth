module

public import CCDN.Center.ChowDistinguishedVariable
import CCDN.Projection.PrimitiveCoordinateField
import Mathlib.RingTheory.AlgebraicIndependent.Basic
import Mathlib.RingTheory.Polynomial.GaussLemma

/-!
The irreducible Chow equation gives the minimal polynomial of
the last generic hyperplane value over the field generated by all its
remaining coefficients and incidence parameters.

An irreducible polynomial relation over a polynomial coefficient ring
becomes the minimal polynomial, up to a nonzero scalar, over its
fraction field.
-/

@[expose] public section
namespace CCDN
noncomputable section

private theorem irreducible_relation_minpoly_degree
    {K R F σ : Type*} [Field K] [Field R] [Field F]
    [Algebra (MvPolynomial σ K) R] [IsFractionRing (MvPolynomial σ K) R]
    [Algebra R F] [Algebra (MvPolynomial σ K) F]
    [IsScalarTower (MvPolynomial σ K) R F]
    (p : Polynomial (MvPolynomial σ K)) (hp : Irreducible p)
    (hpos : 0 < p.natDegree) (z : F)
    (hz : p.eval₂ (algebraMap (MvPolynomial σ K) F) z = 0) :
    (minpoly R z).natDegree = p.natDegree := by
  have hprim : p.IsPrimitive := hp.isPrimitive (Nat.ne_zero_of_lt hpos)
  let q := p.map (algebraMap (MvPolynomial σ K) R)
  have hq : Irreducible q := hprim.irreducible_iff_irreducible_map_fraction_map.mp hp
  have hroot : Polynomial.aeval z q = 0 := by
    change (p.map (algebraMap (MvPolynomial σ K) R)).eval₂ (algebraMap R F) z = 0
    rw [Polynomial.eval₂_map,← IsScalarTower.algebraMap_eq]
    exact hz
  rw [← minpoly.eq_of_irreducible hq hroot,
    Polynomial.natDegree_mul_C_of_isUnit (isUnit_iff_ne_zero.mpr
      (inv_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hq.ne_zero)))]
  exact Polynomial.natDegree_map_eq_of_injective
    (IsFractionRing.injective (MvPolynomial σ K) R) p

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

/-- The coordinate ring of the affine incidence variety of `m + 1` hyperplanes through a point
of the variety of `I`: polynomials in the nonconstant hyperplane coefficients over the
coordinate ring `K[X]/I`. -/
abbrev ChowIncidenceCoordinateRing {K : Type*} [Field K] {n : ℕ} (m : ℕ)
    (I : Ideal (MvPolynomial (Fin n) K)) :=
  MvPolynomial (Fin (m + 1) × Fin n) (MvPolynomial (Fin n) K ⧸ I)

/-- The subfield of `E` generated over `K` by the images of all incidence hyperplane
coefficients except the constant coefficient of the last hyperplane. -/
def chowParameterField {K E : Type*} [Field K] [Field E] [Algebra K E]
    {n : ℕ} (m : ℕ) (I : Ideal (MvPolynomial (Fin n) K))
    [Algebra (ChowIncidenceCoordinateRing m I) E] : IntermediateField K E :=
  IntermediateField.adjoin K (Set.range (fun q : ChowCoefficientVariables m n =>
    algebraMap (ChowIncidenceCoordinateRing m I) E
      (chowIncidenceMap (m + 1) I (X (chowIndependentVariables m n q)))))

/-- The image in `E` of the constant coefficient of the last incidence hyperplane, which equals
minus the value of its linear part at the generic point of the variety of `I`. -/
def chowLastIncidenceValue {K E : Type*} [Field K] [Field E] {n : ℕ}
    (m : ℕ) (I : Ideal (MvPolynomial (Fin n) K))
    [Algebra (ChowIncidenceCoordinateRing m I) E] : E :=
  algebraMap (ChowIncidenceCoordinateRing m I) E
    (chowIncidenceMap (m + 1) I (X (Fin.last m,0)))

/-- If `I` is prime of affine dimension `m` and `F` is an irreducible element of the Chow
incidence ideal, then the degree of `F` in the constant coefficient of the last hyperplane equals
the degree of the minimal polynomial of `chowLastIncidenceValue` over `chowParameterField`, in
any fraction field `E` of the incidence coordinate ring. -/
theorem chow_incidence_minpoly_natDegree
    {K E : Type*} [Field K] [Field E] [Algebra K E] {m n : ℕ}
    (I : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]
    [Algebra (ChowIncidenceCoordinateRing m I) E]
    [IsScalarTower K (ChowIncidenceCoordinateRing m I) E]
    [IsFractionRing (ChowIncidenceCoordinateRing m I) E]
    (hm : (filteredHilbertPolynomial I).natDegree = m)
    (F : MvPolynomial (Fin (m + 1) × Fin (n + 1)) K)
    (hF : Irreducible F) (hmem : F ∈ chowIncidenceIdeal (m + 1) I) :
    (minpoly (chowParameterField (E := E) m I)
      (chowLastIncidenceValue (E := E) m I)).natDegree =
        (chowAsUnivariate K m n F).natDegree := by
  classical
  let T := ChowIncidenceCoordinateRing m I
  let P := MvPolynomial (ChowCoefficientVariables m n) K
  let η : T →ₐ[K] E := IsScalarTower.toAlgHom K T E
  let x : ChowCoefficientVariables m n → E := fun q =>
    η (chowIncidenceMap (m + 1) I (X (chowIndependentVariables m n q)))
  let R := chowParameterField (E := E) m I
  let u : ChowCoefficientVariables m n → R := fun q =>
    ⟨x q,IntermediateField.subset_adjoin K _ ⟨q,rfl⟩⟩
  have hiE : AlgebraicIndependent K x :=
    (chowIncidence_independent_coordinates I hm).map' (IsFractionRing.injective T E)
  have hiR : AlgebraicIndependent K u := AlgebraicIndependent.of_comp R.val hiE
  let ρ : P →ₐ[K] R := aeval u
  let ψ : P →ₐ[K] E := η.comp (chowCoefficientMap m I)
  have hcomp : R.val.comp ρ = ψ := by
    ext q
    simp only [AlgHom.comp_apply,ρ,aeval_X,ψ,chowCoefficientMap,rename_X]
    rfl
  let : Algebra P R := ρ.toRingHom.toAlgebra
  let : Algebra P E := ψ.toRingHom.toAlgebra
  let : IsScalarTower P R E :=
    IsScalarTower.of_algebraMap_eq' (congrArg AlgHom.toRingHom hcomp).symm
  have hgen : IntermediateField.adjoin K (Set.range u) = ⊤ := by
    apply IntermediateField.lift_injective R
    rw [IntermediateField.lift_adjoin,IntermediateField.lift_top,← Set.range_comp]
    rfl
  let : IsFractionRing P R := isFractionRing_of_generating_tuple ρ hiR
    (fun q => X q) (by
      convert hgen using 2
      congr 1
      funext q
      change (aeval u) (X q) = u q
      rw [aeval_X])
  let p := chowAsUnivariate K m n F
  have hp : Irreducible p := (MulEquiv.irreducible_iff (chowAsUnivariate K m n)).mpr hF
  have hpos : 0 < p.natDegree := chowAsUnivariate_natDegree_pos I hm F hF.ne_zero hmem
  have heT : p.eval₂ (chowCoefficientMap m I).toRingHom
      (chowIncidenceMap (m + 1) I (X (Fin.last m,0))) = 0 :=
    (chowIncidenceMap_eq_univariate_eval I F).trans hmem
  have he := congrArg η heT
  change η.toRingHom (p.eval₂ (chowCoefficientMap m I).toRingHom _) = η.toRingHom 0 at he
  rw [Polynomial.hom_eval₂,map_zero] at he
  exact irreducible_relation_minpoly_degree (R := R) p hp hpos
    (chowLastIncidenceValue (E := E) m I) he

end
end CCDN
