module

public import CCDN.Center.ChowIncidenceIdeal
public import CCDN.Hilbert.FilteredHilbertPolynomial
public import Mathlib.RingTheory.AlgebraicIndependent.Defs
public import Mathlib.RingTheory.Ideal.Maps
import CCDN.Center.GenericLinearIndependence
import CCDN.Hilbert.HilbertTranscendenceBasis
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import CCDN.Projection.HilbertProjectionKernel
import Mathlib.RingTheory.Polynomial.UniqueFactorization
import Mathlib.RingTheory.SimpleModule.Basic

/-!
The constructed incidence ideal of m+1 hyperplanes on a
m-dimensional affine variety is generated by an irreducible equation.

More hyperplanes than the affine Hilbert dimension satisfy a
nonzero incidence equation. The equation is constructed from the
elimination kernel, by a transcendence-degree count.

A nonzero polynomial-map kernel containing all but one independent
coordinate is generated by an irreducible equation.
-/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

theorem exists_irreducible_kernel_equation_of_independent_coordinates
    {K A σ τ : Type*} [Field K] [CommRing A] [IsDomain A] [Algebra K A]
    [Fintype σ] [Fintype τ]
    (ψ : MvPolynomial σ K →ₐ[K] A)
    (hne : RingHom.ker ψ ≠ ⊥) (hn : 2 ≤ Fintype.card σ)
    (b : τ → σ) (hcard : Fintype.card τ + 1 = Fintype.card σ)
    (hi : AlgebraicIndependent K (fun i => ψ (X (b i)))) :
    ∃ f : MvPolynomial σ K, Irreducible f ∧ RingHom.ker ψ = Ideal.span {f} := by
  classical
  have hp : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime _
  obtain ⟨f,hf,hprime⟩ := hp.exists_mem_prime_of_ne_bot hne
  let k := Fintype.card σ - 2
  let e : Fin (k + 2) ≃ σ := Fintype.equivOfCardEq (by simp only [Fintype.card_fin]; omega)
  let j : Fin (k + 1) ≃ τ := Fintype.equivOfCardEq (by simp only [Fintype.card_fin]; omega)
  let E := renameEquiv K e
  let f' := E.symm f
  let ψ' := ψ.comp E.toAlgHom
  have hf' : Irreducible f' := (MulEquiv.irreducible_iff (f := E.symm)).mpr hprime.irreducible
  have hz : ψ' f' = 0 := by
    change ψ f = 0 at hf
    simpa [ψ',f'] using hf
  let b' : Fin (k + 1) → MvPolynomial (Fin (k + 2)) K := fun i => X (e.symm (b (j i)))
  have hb' (i) : (b' i).totalDegree ≤ 1 := by simp [b']
  have hi' : AlgebraicIndependent K (fun i => ψ' (b' i)) := by
    convert hi.comp j j.injective using 1
    funext i
    simp [ψ',b',E]
  refine ⟨f,hprime.irreducible,?_⟩
  ext g
  change ψ g = 0 ↔ g ∈ Ideal.span {f}
  rw [Ideal.mem_span_singleton]
  have hh := hypersurface_map_eq_zero_iff_dvd f' hf' ψ' hz b' hb' hi' (E.symm g)
  have hm : ψ' (E.symm g) = ψ g := by simp [ψ']
  rw [hm] at hh
  exact hh.trans (map_dvd_iff E.symm)

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

/-- The incidence elimination ideal is nonzero as soon as the number of
hyperplanes exceeds the dimension of the affine coordinate domain. -/
theorem chowIncidenceIdeal_ne_bot {K : Type*} [Field K] {n r : ℕ}
    (I : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]
    (hr : (filteredHilbertPolynomial I).natDegree < r) :
    chowIncidenceIdeal r I ≠ ⊥ := by
  classical
  intro hbot
  have hinj : Function.Injective (chowIncidenceMap r I) :=
    (RingHom.injective_iff_ker_eq_bot (chowIncidenceMap r I)).mpr hbot
  have hAI : AlgebraicIndependent K (fun q : Fin r × Fin (n + 1) =>
      chowIncidenceMap r I (X q)) :=
    (algebraicIndependent_X (Fin r × Fin (n + 1)) K).map' hinj
  obtain ⟨U,hU,hTB⟩ := exists_hilbert_coordinate_transcendence_basis I
  let A := MvPolynomial (Fin n) K ⧸ I
  have hP := IsTranscendenceBasis.mvPolynomial (Fin r × Fin n) A
  have htarget := hTB.sumElim_comp hP
  have hle := hAI.lift_cardinalMk_le_trdeg
  have heq := htarget.lift_cardinalMk_eq_trdeg
  have hcard : Fintype.card (Fin r × Fin (n + 1)) ≤
      Fintype.card ((Fin r × Fin n) ⊕ U) := by
    simpa only [Cardinal.mk_fintype,Cardinal.lift_natCast,Nat.cast_le] using hle.trans_eq heq.symm
  simp only [Fintype.card_prod,Fintype.card_fin,Fintype.card_sum] at hcard
  rw [Nat.card_eq_fintype_card] at hU
  nlinarith

end
end CCDN

namespace CCDN
noncomputable section
open MvPolynomial

theorem exists_chow_incidence_generator_of_dimension {K : Type*} [Field K] {m n : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 1)) K)) [I.IsPrime]
    (hm : (filteredHilbertPolynomial I).natDegree = m) :
    ∃ F : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K,
      Irreducible F ∧ chowIncidenceIdeal (m + 1) I = Ideal.span {F} := by
  have hne : chowIncidenceIdeal (m + 1) I ≠ ⊥ :=
    chowIncidenceIdeal_ne_bot (r := m + 1) I (by rw [hm]; exact Nat.lt_succ_self m)
  have hn : 2 ≤ Fintype.card (Fin (m + 1) × Fin (n + 2)) := by
    simp only [Fintype.card_prod,Fintype.card_fin]
    calc
      2 ≤ n + 2 := by omega
      _ ≤ (m + 1) * (n + 2) := Nat.le_mul_of_pos_left _ (Nat.succ_pos m)
  have hc : Fintype.card ((Fin (m + 1) × Fin (n + 1)) ⊕ Fin m) + 1 =
      Fintype.card (Fin (m + 1) × Fin (n + 2)) := by
    simp only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    ring
  have hi := chowIncidence_independent_coordinates (m := m) (n := n + 1) I hm
  let ψ : MvPolynomial (Fin (m + 1) × Fin (n + 2)) K →ₐ[K]
      MvPolynomial (Fin (m + 1) × Fin (n + 1)) (MvPolynomial (Fin (n + 1)) K ⧸ I) :=
    chowIncidenceMap (m + 1) I
  have hψ : RingHom.ker ψ ≠ ⊥ := hne
  exact exists_irreducible_kernel_equation_of_independent_coordinates
    (K := K) (A := MvPolynomial (Fin (m + 1) × Fin (n + 1))
      (MvPolynomial (Fin (n + 1)) K ⧸ I))
    (σ := Fin (m + 1) × Fin (n + 2))
    (τ := (Fin (m + 1) × Fin (n + 1)) ⊕ Fin m)
    ψ hψ hn (chowIndependentVariables m (n + 1)) hc hi

end
end CCDN
