module

public import CCDN.Projection.ProjectionScalarExtension
public import CCDN.Projection.BoundedBirationalHypersurfaceProjection
public import Mathlib.LinearAlgebra.Matrix.Rank

/-! Row independence of a normalization and an independent standard
row completing it. A redundant primitive row does not enlarge the field
generated by the normalization rows. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial Module

/-- Rational coefficient vectors interpreted as homogeneous linear forms. -/
def rationalRowLinearForm (n : ℕ) :
    (Fin n → ℚ) →ₗ[ℚ] MvPolynomial (Fin n) ℚ :=
  (Pi.basisFun ℚ (Fin n)).constr ℚ X

lemma rationalRowLinearForm_apply {n : ℕ} (v : Fin n → ℚ) :
    rationalRowLinearForm n v = ∑ j, v j • X j := by
  simp [rationalRowLinearForm]

lemma rationalRowLinearForm_integer {n : ℕ} (a : Fin n → ℤ) :
    rationalRowLinearForm n (fun j => (a j : ℚ)) = integerLinearForm a := by
  rw [rationalRowLinearForm_apply]
  simp only [integerLinearForm, Algebra.smul_def, algebraMap_eq]

/-- Injectivity of the normalization algebra map implies linear
independence of its integer coefficient rows. -/
theorem integer_rows_linearIndependent_of_projection_injective {m n : ℕ}
    (I : Ideal (MvPolynomial (Fin n) ℚ)) (a : Fin m → Fin n → ℤ)
    (hinj : Function.Injective (projectionCoordinateMap I
      (fun i => integerLinearForm (a i)))) :
    LinearIndependent ℚ (fun i => fun j => (a i j : ℚ)) := by
  have hi : AlgebraicIndependent ℚ
      (fun i => (Ideal.Quotient.mk I) (integerLinearForm (a i))) := by
    change Function.Injective (aeval (fun i => (Ideal.Quotient.mk I) (integerLinearForm (a i))))
    rw [← projectionCoordinateMap_eq_aeval]
    exact hinj
  have hl : LinearIndependent ℚ (fun i => integerLinearForm (a i)) :=
    hi.linearIndependent.of_comp (Ideal.Quotient.mkₐ ℚ I).toLinearMap
  apply LinearIndependent.of_comp (rationalRowLinearForm n)
  convert hl using 1
  funext i
  exact rationalRowLinearForm_integer (a i)

/-- When fewer than n rows are independent, some standard unit vector
lies outside their span. No arbitrarily large integer vector is required. -/
theorem exists_standard_row_not_mem_span {m n : ℕ}
    (a : Fin m → Fin n → ℚ) (hli : LinearIndependent ℚ a) (hmn : m < n) :
    ∃ j : Fin n, (fun k => if k = j then (1 : ℚ) else 0) ∉
      Submodule.span ℚ (Set.range a) := by
  classical
  let S := Submodule.span ℚ (Set.range a)
  have hS : S ≠ ⊤ := by
    intro ht
    have hdim := finrank_span_eq_card hli
    change Module.finrank ℚ S = Fintype.card (Fin m) at hdim
    rw [ht, finrank_top, Module.finrank_fin_fun, Fintype.card_fin] at hdim
    omega
  by_contra! h
  apply hS
  apply top_unique
  rw [← (Pi.basisFun ℚ (Fin n)).span_eq]
  apply Submodule.span_le.mpr
  rintro _ ⟨j, rfl⟩
  rw [Pi.basisFun_apply]
  have he : (Pi.single j (1 : ℚ) : Fin n → ℚ) =
      (fun k => if k = j then 1 else 0) := by
    funext k
    simp [Pi.single_apply, eq_comm]
  rw [he]
  exact h j

/-- A first row lying in the ambient linear span of the others contributes
nothing to the intermediate field generated by their linear images. -/
theorem adjoin_linear_images_eq_tail_of_first_mem_span
    {K F V : Type*} [Field K] [Field F] [Algebra K F]
    [AddCommGroup V] [Module K V] {m : ℕ}
    (v : Fin (m + 1) → V) (L : V →ₗ[K] F)
    (hfirst : v 0 ∈ Submodule.span K (Set.range (fun i : Fin m => v i.succ))) :
    IntermediateField.adjoin K (Set.range (fun i => L (v i))) =
      IntermediateField.adjoin K (Set.range (fun i : Fin m => L (v i.succ))) := by
  classical
  let S := IntermediateField.adjoin K (Set.range (fun i : Fin m => L (v i.succ)))
  have h0 : L (v 0) ∈ S := by
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hfirst
    rw [← hc, map_sum]
    apply S.sum_mem
    intro i _
    rw [map_smul]
    exact S.smul_mem (IntermediateField.subset_adjoin K _ (Set.mem_range_self i))
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.cases h0 (fun j => ?_) i
    exact IntermediateField.subset_adjoin K _ (Set.mem_range_self j)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin K _ (Set.mem_range_self i.succ)


/-- Full row rank gives the exact kernel dimension, with no restriction on
an image equation's degree. -/
theorem independent_integer_rows_kernel_dimension {m n : ℕ}
    (b : Fin m → Fin n → ℤ)
    (hli : LinearIndependent ℚ (fun i => fun j => (b i j : ℚ))) :
    let P : Matrix (Fin m) (Fin n) ℚ := fun i j => (b i j : ℚ)
    Function.Surjective P.mulVec ∧ Module.finrank ℚ P.mulVecLin.ker + m = n := by
  let P : Matrix (Fin m) (Fin n) ℚ := fun i j => (b i j : ℚ)
  have hs : Function.Surjective P.mulVec := hli.mulVec_surjective
  refine ⟨hs, ?_⟩
  have hh := P.mulVecLin.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hs, finrank_top] at hh
  simpa only [Module.finrank_pi, Fintype.card_fin, Nat.add_comm] using hh

end
end CCDN
