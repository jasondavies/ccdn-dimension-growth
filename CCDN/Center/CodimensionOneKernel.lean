module

public import Mathlib.RingTheory.AlgebraicIndependent.Defs
public import Mathlib.RingTheory.Ideal.Maps
import CCDN.Projection.HilbertProjectionKernel
import Mathlib.RingTheory.Polynomial.UniqueFactorization
import Mathlib.RingTheory.SimpleModule.Basic
/-! A nonzero polynomial-map kernel containing all but one independent
coordinate is generated by an irreducible equation. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

theorem exists_irreducible_kernel_equation_of_independent_coordinates
    {K A σ τ : Type*} [Field K] [CommRing A] [IsDomain A] [Algebra K A]
    [Fintype σ] [Fintype τ]
    (ψ : MvPolynomial σ K →ₐ[K] A)
    (hne : RingHom.ker ψ ≠ ⊥) (hn : 2 ≤ Fintype.card σ)
    (b : τ → σ) (hcard : Fintype.card τ + 1 = Fintype.card σ)
    (hi : AlgebraicIndependent K (fun i => ψ (X (b i)))) :
    ∃ f : MvPolynomial σ K, Irreducible f ∧ RingHom.ker ψ = Ideal.span {f} := by
  classical
  have hp : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime _
  obtain ⟨f,hf,hprime⟩ := hp.exists_mem_prime_of_ne_bot hne
  let k := Fintype.card σ - 2
  let e : Fin (k + 2) ≃ σ := Fintype.equivOfCardEq (by simp only [Fintype.card_fin]; omega)
  let j : Fin (k + 1) ≃ τ := Fintype.equivOfCardEq (by simp only [Fintype.card_fin]; omega)
  let E := renameEquiv K e
  let f' := E.symm f
  let ψ' := ψ.comp E.toAlgHom
  have hf' : Irreducible f' := (MulEquiv.irreducible_iff (f := E.symm)).mpr hprime.irreducible
  have hz : ψ' f' = 0 := by
    change ψ f = 0 at hf
    simpa [ψ',f'] using hf
  let b' : Fin (k + 1) → MvPolynomial (Fin (k + 2)) K := fun i => X (e.symm (b (j i)))
  have hb' (i) : (b' i).totalDegree ≤ 1 := by simp [b']
  have hi' : AlgebraicIndependent K (fun i => ψ' (b' i)) := by
    convert hi.comp j j.injective using 1
    funext i
    simp [ψ',b',E]
  refine ⟨f,hprime.irreducible,?_⟩
  ext g
  change ψ g = 0 ↔ g ∈ Ideal.span {f}
  rw [Ideal.mem_span_singleton]
  have hh := hypersurface_map_eq_zero_iff_dvd f' hf' ψ' hz b' hb' hi' (E.symm g)
  have hm : ψ' (E.symm g) = ψ g := by simp [ψ']
  rw [hm] at hh
  exact hh.trans (map_dvd_iff E.symm)

end
end CCDN
