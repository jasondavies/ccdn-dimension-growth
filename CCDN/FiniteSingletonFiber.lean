module

public import Mathlib.RingTheory.Nakayama
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.LinearAlgebra.Dimension.FreeAndStrongRankCondition

/-! A finite algebra with a residue fiber generated by one has a nonzero
conductor into the base ring. For domains this forces the fraction-field
map to be surjective. The fiber condition is scheme-theoretic: merely
having one point in its underlying spectrum does not suffice. -/

@[expose] public section
namespace CCDN
noncomputable section

/-- Global Nakayama gives a single base-ring multiplier, congruent to one
at the chosen fiber, that sends the whole finite algebra into the base. -/
theorem finite_algebra_conductor_of_singleton_fiber
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S]
    (I : Ideal R) (hI : I ≠ ⊤)
    (hfiber : Function.Surjective (algebraMap R (S ⧸ I.map (algebraMap R S)))) :
    ∃ r : R, r ≠ 0 ∧ r - 1 ∈ I ∧ ∀ x : S, ∃ a : R,
      algebraMap R S a = algebraMap R S r * x := by
  let N := LinearMap.range (Algebra.linearMap R S)
  have hspan : (⊤ : Submodule R S) ≤ N ⊔ I • (⊤ : Submodule R S) := by
    intro x _
    obtain ⟨a, ha⟩ := hfiber (Ideal.Quotient.mk (I.map (algebraMap R S)) x)
    have hdiff : x - algebraMap R S a ∈ I.map (algebraMap R S) := by
      apply Ideal.Quotient.eq.mp
      exact ha.symm
    apply Submodule.mem_sup.mpr
    refine ⟨algebraMap R S a, ⟨a, rfl⟩, x - algebraMap R S a, ?_, ?_⟩
    · rwa [Ideal.smul_top_eq_map]
    · abel
  obtain ⟨r, hr, hcon⟩ :=
    Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
      (N := N) (P := ⊤) (I := I) Module.Finite.fg_top le_rfl hspan
  have hr0 : r ≠ 0 := by
    intro hz
    apply hI
    apply (Ideal.eq_top_iff_one I).mpr
    have hneg : (-1 : R) ∈ I := by simpa only [hz, zero_sub] using hr
    simpa only [neg_neg] using I.neg_mem hneg
  refine ⟨r, hr0, hr, fun x => ?_⟩
  have hx : r • x ∈ N := hcon (Submodule.smul_mem_pointwise_smul x r ⊤ (by trivial))
  obtain ⟨a, ha⟩ := hx
  exact ⟨a, by simpa only [Algebra.linearMap_apply, Algebra.smul_def] using ha⟩

end
end CCDN
